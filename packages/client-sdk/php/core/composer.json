{
    "name": "calyx/client-sdk-core",
    "description": "PHP client for the Calyx core gRPC API.",
    "type": "library",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "ext-grpc": "*",
        "calyx/client-sdk": "0.1.0",
        "grpc/grpc": "~1.84.1",
        "google/protobuf": "~4.33.6",
        "google/common-protos": "~4.15.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.91"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../client"
        }
    ],
    "autoload": {
        "psr-4": {
            "Calyx\\Client\\Core\\": "src/",
            "Calyx\\Core\\V1\\": "generated/Calyx/Core/V1/",
            "GPBMetadata\\Calyx\\Core\\V1\\": "generated/GPBMetadata/Calyx/Core/V1/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calyx\\Client\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}

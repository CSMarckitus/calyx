{
    "name": "calyx/client-sdk",
    "description": "PHP client for the Calyx backend API, with webhook checks.",
    "type": "library",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.91"
    },
    "autoload": {
        "psr-4": {
            "Calyx\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calyx\\Client\\Tests\\": "tests/",
            "Calyx\\Client\\Examples\\": "examples/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}

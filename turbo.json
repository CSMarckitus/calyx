{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:check": {
      "cache": false
    },
    "lint": {},
    "test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "vet": {
      "cache": false
    }
  }
}

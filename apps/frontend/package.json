{
  "name": "@calyx/frontend",
  "version": "0.1.0",
  "description": "The web page of Calyx, on top of the backend.",
  "author": "CSMarckitus <88045486+CSMarckitus@users.noreply.github.com>",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/size.ts",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:ui:csp": "CALYX_UI=csp playwright test --project csp",
    "test:image": "vitest run --config vitest.image.config.ts",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "tsx scripts/generate.ts",
    "generate:check": "tsx scripts/generate.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@scalar/api-reference-react": "0.9.96",
    "@tanstack/react-query": "^5.108.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}

# Copy this file to .env (next to docker-compose.yml) and fill it in. Never commit .env.
#
# This file and the table "Values to fill in" of README.md list every value. Change both together.
#
# How to read it:
# - A line without "#" is a value to fill in. The "Needed by" line says which installations need
#   it. Leave the values of the other installations empty.
# - A line that starts with "#" is optional, and shows its default. To change it, remove the "#"
#   and set your value.
#
# The installations (the numbers of the README and of docker-compose.yml):
#   1. Core alone
#   2. Core with a webhook queue (Redis)
#   3. Everything, with a domain and HTTPS (production)
#   4. Everything on one machine, with no domain (http://localhost:8080)
#
# The core and the backend check these values at start. They refuse empty required values and
# placeholders (anything under example.com, example.org or example.net, and "changeme").

# =============================================================================================
# Values to fill in
# =============================================================================================

# Token between the backend and the core, at least 32 characters. Make one: openssl rand -hex 32
# Needed by: 1, 2, 3, 4.
CORE_TOKEN=

# Password of PostgreSQL. Letters and digits only: it goes inside a URL.
# Make one: openssl rand -hex 24
# Needed by: 3, 4.
POSTGRES_PASSWORD=

# Key that encrypts the webhook secrets: 32 bytes in standard base64. Make one: openssl rand -base64 32
# Back it up with the database. Without it, the stored webhook secrets cannot be read.
# Needed by: 3, 4.
SECRET_KEY=

# Domain of Calyx, without https://, for example calyx.your-domain.com. Traefik gets its HTTPS
# certificate for it from Let's Encrypt. Point the DNS record of the domain to the server first.
# Needed by: 3.
CALYX_DOMAIN=

# Email of the Let's Encrypt account (a real address).
# Needed by: 3.
ACME_EMAIL=

# Address of Calyx for the browser: used in mail links and in the CSRF check. No path.
# Needed by: 4, with the value http://localhost:8080.
# In 3, leave it empty: it is https://<CALYX_DOMAIN>.
PUBLIC_URL=

# Redis for the webhook queue. With a value, the core puts the webhooks in Redis, and the
# core-worker service delivers them with retries.
# Needed by: 2, with the value redis://cache:6379.
REDIS_URL=

# =============================================================================================
# Optional values
# =============================================================================================

# Mail, for invitations, password resets and the alerts when a number disconnects.
# Without SMTP_HOST, the backend gives the invitation and reset links instead of sending them,
# and it sends no alerts. Set SMTP_HOST, SMTP_FROM and OPERATOR_EMAIL together. The backend uses
# STARTTLS (port 465 is not supported). Check the settings with: backend mail test <address>
# Used by: 3, 4.
# SMTP server name.
#SMTP_HOST=
# SMTP port, 1 to 65535.
#SMTP_PORT=587
# SMTP user. Set it together with SMTP_PASSWORD.
#SMTP_USERNAME=
#SMTP_PASSWORD=
# Sender address, such as "Calyx <calyx@your-domain.test>".
#SMTP_FROM=
# Address that gets the "core unreachable" mail.
#OPERATOR_EMAIL=

# WhatsApp Web for new organizations: allowed or blocked.
# Used by: 3, 4.
#WHATSAPP_WEB_DEFAULT=allowed

# The MCP server of the backend, at /mcp, for AI agents: true or false. With false, /mcp
# answers 404.
# Used by: 3, 4.
#MCP_ENABLED=true

# Meta Cloud instances: the endpoint that gets the webhooks of Meta. Set both values together.
# Used by: 1, 2, 3, 4.
# Port of the webhook endpoint in the core (1 to 65535), for example 8081. Default: off.
#META_WEBHOOK_PORT=
# Verify token that Meta sends back. Make one: openssl rand -hex 16
#CORE_META_VERIFY_TOKEN=
